[Unit]
Description=Ada Telegram Bridge — inbound Telegram to Ada Core D-Bus
After=network.target ada-core.service
Requires=ada-core.service

[Service]
Type=simple
User=adarilling
Group=adarilling
WorkingDirectory=/usr/lib/ada-core
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/lib/ada-core/venv/bin/python3 /usr/lib/ada-core/telegram_service.py
Restart=on-failure
RestartSec=5
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
